# Server runtime configuration. Keep the actual file owner-readable only.
LMSTEST_ROOT=/srv/lmstest
WEEKLY_FEEDBACK_PUBLIC_DIR=/srv/weekly-feedback/public
WEEKLY_FEEDBACK_PUBLIC_BASE_URL=https://feedback.example.com

# Configure the already-authorized Lark user/bot profile on the server; never
# put its access token in this file or commit it.
LARK_PROFILE=source-school
LARK_IDENTITY=user

# Required only for live AI generation. All three are required together.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
