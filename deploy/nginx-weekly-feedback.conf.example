# Include this server block in the existing Nginx configuration after replacing
# feedback.example.com.  Only frozen, teacher-confirmed publications are served.
server {
    listen 80;
    server_name feedback.example.com;

    # Redirect to the site's existing TLS server once its certificate is ready.
    # return 301 https://$host$request_uri;

    location = /weekly-feedback {
        return 301 /weekly-feedback/;
    }

    location /weekly-feedback/ {
        alias /srv/weekly-feedback/public/;
        autoindex off;
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Cache-Control "private, max-age=0, no-store" always;
    }

    # No alias is configured for previews, input exports, AI source texts, or
    # Base draft snapshots.  They stay outside /srv/weekly-feedback/public.
}
