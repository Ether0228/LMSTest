# 运行模式：mock | feishu
AUTH_MODE=mock

# Server
PORT=8787
BASE_URL=http://localhost:8787
SESSION_SECRET=change-me-please

# 多租户配置（JSON，必须是单行且是合法 JSON）
#
# 只想先跑 tenant_a 也可以，把 tenant_b 删掉即可。
#
# TENANTS_JSON={"tenant_a":{"appId":"...","appSecret":"...","appToken":"...","submissionsTableId":"...","rosterTableId":"...","libTableId":"...","missingTableId":"...","missingStudentNameField":"学生姓名","summaryTableId":"tbl_summary_xxx"}}
TENANTS_JSON={}

# 可选：默认关闭。设为 1 时，当缺交表无法按姓名过滤会回退全表扫描（慢）。
ALLOW_MISSING_FULL_SCAN=0

# 可选：默认关闭。设为 1 时，汇总表查不到学生会回退实时全表计算（更慢）。
ALLOW_LIVE_FALLBACK_WHEN_SUMMARY_MISS=0
